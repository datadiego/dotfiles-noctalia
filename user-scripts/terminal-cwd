#!/bin/bash

set -euo pipefail

terminal_pid=""

if command -v hyprctl &>/dev/null && hyprctl activewindow &>/dev/null 2>&1; then
  terminal_pid=$(hyprctl activewindow 2>/dev/null | awk '/pid:/ {print $2}')
elif command -v niri &>/dev/null; then
  terminal_pid=$(niri msg --json focused-window 2>/dev/null | jq -r '.pid // empty')
fi

cwd=""

if [[ -n $terminal_pid ]]; then
  shell_pid=$(pgrep -P "$terminal_pid" 2>/dev/null | tail -n1)
  if [[ -n $shell_pid ]]; then
    cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null || true)
    if [[ -n $cwd ]]; then
      shell=$(readlink -f "/proc/$shell_pid/exe" 2>/dev/null || true)
      if [[ -n $shell ]] && ! grep -Fqsx "$shell" /etc/shells; then
        cwd=""
      fi
    fi
  fi
fi

echo "${cwd:-$HOME}"
